<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:GearFit.Localization"
             xmlns:ctl="clr-namespace:GearFit.Controls"
             xmlns:vm="clr-namespace:GearFit.ViewModels"
             xmlns:models="clr-namespace:GearFit.Models"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="GearFit.Pages.RoutineEditPage"
             x:DataType="vm:RoutineEditViewModel"
             Title="Rutin"
             SafeAreaEdges="Container">

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="4,8,12,0" HeightRequest="64">
            <Border Style="{StaticResource IconButton}" SemanticProperties.Description="{loc:T close}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding CloseCommand}" />
                </Border.GestureRecognizers>
                <ctl:Icon Name="close" Size="24" Thickness="2" IconColor="{DynamicResource Text}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <Label Grid.Column="1" Text="{Binding Title}" FontFamily="BarlowSemi" FontSize="19"
                   HorizontalTextAlignment="Center" VerticalOptions="Center" />
            <Button Grid.Column="2" Text="{loc:T save}" Command="{Binding SaveCommand}" IsEnabled="{Binding CanSave}"
                    HeightRequest="44" FontSize="16" CornerRadius="12" VerticalOptions="Center" />
        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,8,16,24" Spacing="0">
                <Label Text="{loc:T name}" Style="{StaticResource Caps}" Margin="0,0,0,8" />
                <Border HeightRequest="52" Padding="14,0" BackgroundColor="{DynamicResource Surface}" StrokeThickness="0">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="12" />
                    </Border.StrokeShape>
                    <Entry Text="{Binding Name}" Placeholder="{loc:T routine_name_ph}" FontSize="17" MaxLength="30" VerticalOptions="Center"
                           SemanticProperties.Description="{loc:T routine_name}" />
                </Border>

                <Label Text="{loc:T exercises}" Style="{StaticResource Caps}" Margin="0,22,0,8" />

                <Label Text="{loc:T routine_empty}" Style="{StaticResource MutedLabel}" IsVisible="{Binding IsEmpty}" Margin="0,0,0,10" />

                <VerticalStackLayout Spacing="8" BindableLayout.ItemsSource="{Binding Exercises}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="models:Exercise">
                            <Border Style="{StaticResource Card}" Padding="16,0,4,0" HeightRequest="64">
                                <Border.StrokeShape>
                                    <shapes:RoundRectangle CornerRadius="14" />
                                </Border.StrokeShape>
                                <Grid ColumnDefinitions="*,44,44">
                                    <VerticalStackLayout VerticalOptions="Center">
                                        <Label Text="{Binding Name}" FontFamily="BarlowSemi" FontSize="17" />
                                        <Label Text="{Binding GroupDisplay}" Style="{StaticResource MutedLabel}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Style="{StaticResource IconButton}" SemanticProperties.Description="{loc:T move_up}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnMoveUpTapped" />
                                        </Border.GestureRecognizers>
                                        <ctl:Icon Name="arrow-up" Size="20" Thickness="2" IconColor="{DynamicResource Muted}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                    <Border Grid.Column="2" Style="{StaticResource IconButton}" SemanticProperties.Description="{loc:T remove}">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer Tapped="OnRemoveTapped" />
                                        </Border.GestureRecognizers>
                                        <ctl:Icon Name="close" Size="20" Thickness="2" IconColor="{DynamicResource Muted}" HorizontalOptions="Center" VerticalOptions="Center" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border Margin="0,10,0,0" HeightRequest="52" Stroke="{DynamicResource Dashed}" StrokeThickness="1.5"
                        StrokeDashArray="4,3" BackgroundColor="Transparent" SemanticProperties.Description="{loc:T add_exercise}">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddExercisesCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <ctl:Icon Name="plus" Size="20" Thickness="2.2" IconColor="{DynamicResource Accent}" VerticalOptions="Center" />
                        <Label Text="{loc:T add_exercise}" TextColor="{DynamicResource Accent}" FontFamily="BarlowSemi" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
