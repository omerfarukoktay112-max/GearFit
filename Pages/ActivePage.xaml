<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:loc="clr-namespace:GearFit.Localization"
             xmlns:ctl="clr-namespace:GearFit.Controls"
             xmlns:vm="clr-namespace:GearFit.ViewModels"
             xmlns:svc="clr-namespace:GearFit.Services"
             xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls"
             x:Class="GearFit.Pages.ActivePage"
             x:DataType="vm:ActiveViewModel"
             Title="Aktif antrenman"
             SafeAreaEdges="Container">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Üst çubuk -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Padding="4,8,16,0" HeightRequest="68">
            <Border Style="{StaticResource IconButton}" SemanticProperties.Description="{loc:T back_keep}">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding BackCommand}" />
                </Border.GestureRecognizers>
                <ctl:Icon Name="back" Size="24" Thickness="2" IconColor="{DynamicResource Text}" HorizontalOptions="Center" VerticalOptions="Center" />
            </Border>
            <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                <Label Text="{Binding Session.Name}" Style="{StaticResource Caps}" FontSize="12" />
                <Label Text="{Binding Session.ElapsedText}" FontFamily="BarlowCond" FontSize="30" />
            </VerticalStackLayout>
            <Button Grid.Column="2" Text="{loc:T finish}" Command="{Binding FinishCommand}" HeightRequest="44" FontSize="16" CornerRadius="12" VerticalOptions="Center" />
        </Grid>

        <!-- PR bandı -->
        <Border x:Name="PrBanner" Grid.Row="1" Margin="16,4,16,0" HeightRequest="48" Padding="14,0" IsVisible="{Binding Session.HasPr}"
                BackgroundColor="{DynamicResource AccentDim}" Stroke="{DynamicResource AccentLine}" StrokeThickness="1">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="14" />
            </Border.StrokeShape>
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <ctl:Icon Name="trophy" Size="20" IconColor="{DynamicResource Accent}" VerticalOptions="Center" />
                <Label FontSize="15" VerticalOptions="Center">
                    <Label.FormattedText>
                        <FormattedString>
                            <Span Text="{loc:T new_pr}" TextColor="{DynamicResource Accent}" FontFamily="BarlowSemi" />
                            <Span Text=" · " />
                            <Span Text="{Binding Session.PrText}" />
                        </FormattedString>
                    </Label.FormattedText>
                </Label>
            </HorizontalStackLayout>
        </Border>

        <!-- Egzersizler -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,10,16,24" Spacing="10">

                <VerticalStackLayout Spacing="10" BindableLayout.ItemsSource="{Binding Session.Exercises}">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="svc:ActiveExerciseVM">
                            <Border Style="{StaticResource Card}" Padding="12">
                                <VerticalStackLayout>
                                    <Grid ColumnDefinitions="*,44" HeightRequest="40">
                                        <Label Text="{Binding Name}" FontFamily="BarlowSemi" FontSize="19" VerticalOptions="Center" />
                                        <Border Grid.Column="1" Style="{StaticResource IconButton}" Margin="0,0,-10,0" SemanticProperties.Description="{loc:T exercise_options}">
                                            <Border.GestureRecognizers>
                                                <TapGestureRecognizer Tapped="OnExerciseMenuTapped" />
                                            </Border.GestureRecognizers>
                                            <ctl:Icon Name="dots" Size="20" IconColor="{DynamicResource Muted}" HorizontalOptions="Center" VerticalOptions="Center" />
                                        </Border>
                                    </Grid>

                                    <Grid ColumnDefinitions="32,*,72,64,44" ColumnSpacing="8" HeightRequest="20">
                                        <Label Text="{loc:T set}" Style="{StaticResource Caps}" FontSize="12" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="1" Text="{loc:T previous}" Style="{StaticResource Caps}" FontSize="12" />
                                        <Label Grid.Column="2" Text="{loc:T kg}" Style="{StaticResource Caps}" FontSize="12" HorizontalTextAlignment="Center" />
                                        <Label Grid.Column="3" Text="{loc:T reps}" Style="{StaticResource Caps}" FontSize="12" HorizontalTextAlignment="Center" />
                                    </Grid>

                                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding Sets}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="svc:ActiveSetVM">
                                                <Border HeightRequest="50" Margin="-6,0" Padding="6,0" StrokeThickness="0" BackgroundColor="Transparent">
                                                    <Border.StrokeShape>
                                                        <shapes:RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Border.Triggers>
                                                        <DataTrigger TargetType="Border" Binding="{Binding Done}" Value="True">
                                                            <Setter Property="BackgroundColor" Value="{DynamicResource AccentRow}" />
                                                        </DataTrigger>
                                                    </Border.Triggers>
                                                    <Grid ColumnDefinitions="32,*,72,64,44" ColumnSpacing="8">
                                                        <Label Text="{Binding Number}" FontFamily="BarlowSemi" TextColor="{DynamicResource Muted}"
                                                               HorizontalTextAlignment="Center" VerticalOptions="Center" />
                                                        <Label Grid.Column="1" Text="{Binding PreviousText}" FontSize="15" TextColor="{DynamicResource Faint}" VerticalOptions="Center" />

                                                        <Border Grid.Column="2" HeightRequest="44" StrokeThickness="0" BackgroundColor="{DynamicResource Surface2}" VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <shapes:RoundRectangle CornerRadius="10" />
                                                            </Border.StrokeShape>
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border" Binding="{Binding Done}" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentDim}" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Entry Text="{Binding WeightText}" Keyboard="Numeric" Placeholder="0" FontFamily="BarlowSemi" FontSize="18"
                                                                   HorizontalTextAlignment="Center" VerticalOptions="Center"
                                                                   SemanticProperties.Description="{loc:T a11y_weight}" Focused="OnEntryFocused" />
                                                        </Border>

                                                        <Border Grid.Column="3" HeightRequest="44" StrokeThickness="0" BackgroundColor="{DynamicResource Surface2}" VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <shapes:RoundRectangle CornerRadius="10" />
                                                            </Border.StrokeShape>
                                                            <Border.Triggers>
                                                                <DataTrigger TargetType="Border" Binding="{Binding Done}" Value="True">
                                                                    <Setter Property="BackgroundColor" Value="{DynamicResource AccentDim}" />
                                                                </DataTrigger>
                                                            </Border.Triggers>
                                                            <Entry Text="{Binding RepsText}" Keyboard="Numeric" Placeholder="0" FontFamily="BarlowSemi" FontSize="18"
                                                                   HorizontalTextAlignment="Center" VerticalOptions="Center"
                                                                   SemanticProperties.Description="{loc:T reps}" Focused="OnEntryFocused" />
                                                        </Border>

                                                        <Border Grid.Column="4" Style="{StaticResource IconButton}" SemanticProperties.Description="{loc:T a11y_complete_set}">
                                                            <Border.GestureRecognizers>
                                                                <TapGestureRecognizer Tapped="OnSetTapped" />
                                                            </Border.GestureRecognizers>
                                                            <Border WidthRequest="36" HeightRequest="36" StrokeThickness="0" BackgroundColor="{DynamicResource Surface2}"
                                                                    HorizontalOptions="Center" VerticalOptions="Center">
                                                                <Border.StrokeShape>
                                                                    <shapes:RoundRectangle CornerRadius="10" />
                                                                </Border.StrokeShape>
                                                                <Border.Triggers>
                                                                    <DataTrigger TargetType="Border" Binding="{Binding Done}" Value="True">
                                                                        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
                                                                    </DataTrigger>
                                                                </Border.Triggers>
                                                                <ctl:Icon Name="check" Size="20" Thickness="2.6" IconColor="{DynamicResource Faint}" HorizontalOptions="Center" VerticalOptions="Center">
                                                                    <ctl:Icon.Triggers>
                                                                        <DataTrigger TargetType="ctl:Icon" Binding="{Binding Done}" Value="True">
                                                                            <Setter Property="IconColor" Value="{DynamicResource OnAccent}" />
                                                                        </DataTrigger>
                                                                    </ctl:Icon.Triggers>
                                                                </ctl:Icon>
                                                            </Border>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </BindableLayout.ItemTemplate>
                                    </VerticalStackLayout>

                                    <Button Text="{loc:T add_set}" Style="{StaticResource Secondary}" Margin="0,8,0,0" Clicked="OnAddSetClicked" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

                <Border HeightRequest="48" Stroke="{DynamicResource Dashed}" StrokeThickness="1.5" StrokeDashArray="4,3"
                        BackgroundColor="Transparent" SemanticProperties.Description="{loc:T add_exercise}">
                    <Border.StrokeShape>
                        <shapes:RoundRectangle CornerRadius="14" />
                    </Border.StrokeShape>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding AddExerciseCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="8" HorizontalOptions="Center" VerticalOptions="Center">
                        <ctl:Icon Name="plus" Size="20" Thickness="2.2" IconColor="{DynamicResource Accent}" VerticalOptions="Center" />
                        <Label Text="{loc:T add_exercise}" TextColor="{DynamicResource Accent}" FontFamily="BarlowSemi" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>

        <!-- Dinlenme sayacı -->
        <Border x:Name="RestPanel" Grid.Row="3" IsVisible="{Binding Session.RestActive}" Padding="16,0,16,16" StrokeThickness="0"
                BackgroundColor="{DynamicResource Surface2}">
            <Border.StrokeShape>
                <shapes:RoundRectangle CornerRadius="20,20,0,0" />
            </Border.StrokeShape>
            <VerticalStackLayout Spacing="12">
                <ProgressBar Progress="{Binding Session.RestProgress}" ProgressColor="{DynamicResource Accent}"
                             BackgroundColor="{DynamicResource Surface3}" Margin="-16,0" HeightRequest="4" />
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout>
                        <Label Text="{loc:T rest}" Style="{StaticResource Caps}" FontSize="12" />
                        <Label Text="{Binding Session.RestText}" FontFamily="BarlowCond" FontSize="42" />
                    </VerticalStackLayout>
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" VerticalOptions="Center">
                        <Button Text="−15" Command="{Binding AdjustRestCommand}" CommandParameter="-15"
                                BackgroundColor="{DynamicResource Surface3}" TextColor="{DynamicResource Text}"
                                WidthRequest="56" HeightRequest="48" CornerRadius="12" Padding="0" FontSize="16"
                                SemanticProperties.Description="{loc:T a11y_minus15}" />
                        <Button Text="+15" Command="{Binding AdjustRestCommand}" CommandParameter="15"
                                BackgroundColor="{DynamicResource Surface3}" TextColor="{DynamicResource Text}"
                                WidthRequest="56" HeightRequest="48" CornerRadius="12" Padding="0" FontSize="16"
                                SemanticProperties.Description="{loc:T a11y_plus15}" />
                        <Button Text="{loc:T skip}" Command="{Binding SkipRestCommand}"
                                BackgroundColor="{DynamicResource Text}" TextColor="{DynamicResource Bg}"
                                HeightRequest="48" CornerRadius="12" Padding="20,0" FontSize="16" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>
