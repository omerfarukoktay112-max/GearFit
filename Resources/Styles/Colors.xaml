<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Varsayılan (koyu) palet. Çalışma anında ThemeService aynı anahtarları üzerine yazar. -->
    <Color x:Key="Bg">#121110</Color>
    <Color x:Key="Surface">#1C1A18</Color>
    <Color x:Key="Surface2">#262320</Color>
    <Color x:Key="Surface3">#332F2A</Color>
    <Color x:Key="Line">#2B2723</Color>
    <Color x:Key="Text">#F3EFEA</Color>
    <Color x:Key="Muted">#A39B92</Color>
    <Color x:Key="Faint">#948C83</Color>
    <Color x:Key="Accent">#FF7A3D</Color>
    <Color x:Key="OnAccent">#14120F</Color>
    <Color x:Key="AccentDim">#3A2216</Color>
    <Color x:Key="AccentRow">#2A1D15</Color>
    <Color x:Key="AccentLine">#7A3D1E</Color>
    <Color x:Key="Dashed">#4A443D</Color>
    <Color x:Key="Scrim">#99000000</Color>

    <SolidColorBrush x:Key="BgBrush" Color="#121110" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1A18" />
    <SolidColorBrush x:Key="Surface2Brush" Color="#262320" />
    <SolidColorBrush x:Key="Surface3Brush" Color="#332F2A" />
    <SolidColorBrush x:Key="LineBrush" Color="#2B2723" />
    <SolidColorBrush x:Key="TextBrush" Color="#F3EFEA" />
    <SolidColorBrush x:Key="MutedBrush" Color="#A39B92" />
    <SolidColorBrush x:Key="FaintBrush" Color="#948C83" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7A3D" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#14120F" />
    <SolidColorBrush x:Key="AccentDimBrush" Color="#3A2216" />
    <SolidColorBrush x:Key="AccentRowBrush" Color="#2A1D15" />
    <SolidColorBrush x:Key="AccentLineBrush" Color="#7A3D1E" />
    <SolidColorBrush x:Key="DashedBrush" Color="#4A443D" />
    <SolidColorBrush x:Key="ScrimBrush" Color="#99000000" />
</ResourceDictionary>
