<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:shapes="clr-namespace:Microsoft.Maui.Controls.Shapes;assembly=Microsoft.Maui.Controls">

    <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
        <Setter Property="BackgroundColor" Value="{DynamicResource Bg}" />
        <Setter Property="Shell.NavBarIsVisible" Value="False" />
        <Setter Property="Shell.TabBarIsVisible" Value="False" />
    </Style>

    <Style TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="LineBreakMode" Value="TailTruncation" />
    </Style>

    <!-- Sayfa başlığı: Barlow Condensed 36 -->
    <Style x:Key="PageTitle" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowCond" />
        <Setter Property="FontSize" Value="36" />
        <Setter Property="VerticalOptions" Value="Center" />
    </Style>

    <Style x:Key="Display" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowCond" />
        <Setter Property="FontSize" Value="44" />
    </Style>

    <!-- Büyük harfli küçük bölüm başlığı -->
    <Style x:Key="Caps" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemi" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="CharacterSpacing" Value="1" />
        <Setter Property="TextTransform" Value="Uppercase" />
        <Setter Property="TextColor" Value="{DynamicResource Muted}" />
    </Style>

    <Style x:Key="MutedLabel" TargetType="Label">
        <Setter Property="TextColor" Value="{DynamicResource Muted}" />
        <Setter Property="FontSize" Value="14" />
    </Style>

    <Style x:Key="Strong" TargetType="Label">
        <Setter Property="FontFamily" Value="BarlowSemi" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="16" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Chip" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="StrokeShape">
            <Setter.Value>
                <shapes:RoundRectangle CornerRadius="22" />
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="Entry">
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="PlaceholderColor" Value="{DynamicResource Faint}" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="FontFamily" Value="Barlow" />
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Accent}" />
        <Setter Property="TextColor" Value="{DynamicResource OnAccent}" />
        <Setter Property="FontFamily" Value="BarlowSemi" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="HeightRequest" Value="56" />
        <Setter Property="Padding" Value="20,0" />
    </Style>

    <Style x:Key="Secondary" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{DynamicResource Surface2}" />
        <Setter Property="TextColor" Value="{DynamicResource Text}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="HeightRequest" Value="40" />
    </Style>

    <Style x:Key="IconButton" TargetType="Border">
        <Setter Property="StrokeThickness" Value="0" />
        <Setter Property="WidthRequest" Value="44" />
        <Setter Property="HeightRequest" Value="44" />
        <Setter Property="BackgroundColor" Value="Transparent" />
    </Style>
</ResourceDictionary>
