<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:GearFit.Pages"
       x:Class="GearFit.AppShell"
       FlyoutBehavior="Disabled"
       BackgroundColor="{DynamicResource Bg}"
       Shell.NavBarIsVisible="False"
       Shell.TabBarIsVisible="False">

    <ShellContent Route="main" ContentTemplate="{DataTemplate pages:MainPage}" />
    <ShellContent Route="history" ContentTemplate="{DataTemplate pages:HistoryPage}" />
    <ShellContent Route="progress" ContentTemplate="{DataTemplate pages:ProgressPage}" />
    <ShellContent Route="body" ContentTemplate="{DataTemplate pages:BodyPage}" />
</Shell>
